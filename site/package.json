{
  "name": "bookshelf",
  "version": "0.1.0",
  "private": true,
  "description": "A small reading-list web app: JSON API plus server-rendered pages.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node src/server.js",
    "build": "node scripts/build.mjs",
    "test": "node --test \"test/**/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-exclude=\"src/client/**\" \"test/**/*.test.js\"",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "express": "5.2.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
